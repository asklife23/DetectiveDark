  "@dialogueNoTopics": {
    "description": "Shown in the dialogue panel when the character has no question on offer. In the voice of the detective."
  },
  "dialogueShowEvidence": "Show evidence",
  "@dialogueShowEvidence": {
    "description": "Button in the dialogue panel: opens the notebook so the player can pick a note and show it to the character. Little space: keep it short."
  },
  "notebookShowButton": "Show",
  "@notebookShowButton": {
    "description": "Button under the open note while the player picks evidence for a character: shows this note to the character."
  },
  "notebookPickEvidenceHint": "Pick the note to show.",
  "@notebookPickEvidenceHint": {
    "description": "Shown on the right page of the notebook while the player picks evidence for a character and no note is selected yet."
  },
  "chatTooltip": "Thoughts",
  "@chatTooltip": {
    "description": "Label of the HUD button that opens the history of the detective's inner voice, and title of that history."
  },
  "chatHistoryEmpty": "Nothing on my mind yet.",
  "@chatHistoryEmpty": {
    "description": "Shown in the message history while the detective has not said anything. In the voice of the detective."
  },
  "debugHotspotsTooltip": "Show hotspots",
  "@debugHotspotsTooltip": {
    "description": "Developer tool, visible only in dev builds: toggles the outlines of the tappable areas."
  },
  "devMenuTooltip": "Developer menu",
  "@devMenuTooltip": {
    "description": "Developer tool, dev builds only: label of the button that opens the developer menu."
  },
  "devMenuTitle": "Developer menu",
  "@devMenuTitle": {
    "description": "Developer menu: title."
  },
  "devMenuTabScenes": "Scenes",
  "@devMenuTabScenes": {
    "description": "Developer menu: tab that lists the scenes to jump to."
  },
  "devMenuTabItems": "Items",
  "@devMenuTabItems": {
    "description": "Developer menu: tab that lists the items that can be added to the inventory."
  },
  "devMenuTabNotes": "Notes",
  "@devMenuTabNotes": {
    "description": "Developer menu: tab that lists the notes that can be added to the notebook."
  },
  "devMenuTabFlags": "Flags",
  "@devMenuTabFlags": {
    "description": "Developer menu: tab that lists the story flags that can be set."
  },
  "devMenuTabPresets": "Presets",
  "@devMenuTabPresets": {
    "description": "Developer menu: tab that lists the named game states that can be loaded."
  },
  "devMenuReset": "Reset progress",
  "@devMenuReset": {
    "description": "Developer menu: button that starts the case again from the beginning."
  },
  "devMenuNoPresets": "This build contains no presets.",
  "@devMenuNoPresets": {
    "description": "Developer menu: shown on the presets tab when the preset file is not part of the build (e.g. on Windows)."
  },
  "devMenuActionFailed": "That did not work. See the log.",
  "@devMenuActionFailed": {
    "description": "Developer menu: shown when an action (jump, add, reset, preset, paste save) failed."
  },
  "devMenuCopySave": "Copy save",
  "@devMenuCopySave": {
    "description": "Developer menu: button that copies the current save game as JSON text to the clipboard."
  },
  "devMenuPasteSave": "Paste save",
  "@devMenuPasteSave": {
    "description": "Developer menu: button that replaces the progress with the save game JSON in the clipboard."
  },
  "devMenuSaveCopied": "Save copied to the clipboard.",
  "@devMenuSaveCopied": {
    "description": "Developer menu: shown after the save game was copied to the clipboard."
  }
}

{
  "@@locale": "en",
  "appTitle": "DetectiveDark",
  "@appTitle": {
    "description": "Name of the game. Shown in the OS task switcher, the window title and on screen."
  },
  "backTooltip": "Back",
  "@backTooltip": {
    "description": "Label of the HUD button that returns to the previous scene."
  },
  "closeTooltip": "Close",
  "@closeTooltip": {
    "description": "Label of the button that closes a panel (inspection panel, notebook, message history, dialogue panel)."
  },
  "exitHint": "Press back again to leave the game.",
  "@exitHint": {
    "description": "Shown when the player presses the system back button in a main scene. A second press closes the app."
  },
  "gameLoadFailed": "The case files could not be opened.",
  "@gameLoadFailed": {
    "description": "Shown instead of the game when the game content failed to load."
  },
  "retryButton": "Try again",
  "@retryButton": {
    "description": "Button that repeats a failed action, e.g. loading the game content."
  },
  "saveTooNewTitle": "This saved case comes from a newer version of the game.",
  "@saveTooNewTitle": {
    "description": "Shown instead of the game when the save was written by a newer version of the game than the installed one. The save is left untouched."
  },
  "saveTooNewBody": "Update the game to continue. Your progress is safe.",
  "@saveTooNewBody": {
    "description": "Second line under saveTooNewTitle: tells the player what to do."
  },
  "saveCorruptTitle": "Your saved case could not be read.",
  "@saveCorruptTitle": {
    "description": "Shown instead of the game when the save file is damaged."
  },
  "saveCorruptBody": "It was set aside, not deleted. You can start a new case.",
  "@saveCorruptBody": {
    "description": "Second line under saveCorruptTitle: the damaged save was kept as a backup and a new game can be started."
  },
  "newGameButton": "New game",
  "@newGameButton": {
    "description": "Button that starts the case from the beginning."
  },
  "inventoryLabel": "Inventory",
  "@inventoryLabel": {
    "description": "Accessibility label of the item panel on the right edge of the screen."
  },
  "inventoryEmpty": "Nothing yet",
  "@inventoryEmpty": {
    "description": "Shown in the item panel while the player carries no items. Very little space: keep it to two short words."
  },
  "notebookTooltip": "Notebook",
  "@notebookTooltip": {
    "description": "Label of the HUD button that opens the notebook, and title of the notebook."
  },
  "notebookTabDocuments": "Documents",
  "@notebookTabDocuments": {
    "description": "Notebook tab: letters, clippings, receipts, photos."
  },
  "notebookTabObservations": "Observations",
  "@notebookTabObservations": {
    "description": "Notebook tab: conclusions the detective has drawn."
  },
  "notebookTabPeople": "People",
  "@notebookTabPeople": {
    "description": "Notebook tab: one file per person the detective has met or heard of. Each file grows line by line as the game goes on."
  },
  "notebookEmptyDocuments": "No papers yet. Somebody always leaves something behind.",
  "@notebookEmptyDocuments": {
    "description": "Shown in the Documents tab of the notebook while it is empty. Atmospheric, in the voice of the detective."
  },
  "notebookEmptyObservations": "Nothing worth writing down. Not yet.",
  "@notebookEmptyObservations": {
    "description": "Shown in the Observations tab of the notebook while it is empty. Atmospheric, in the voice of the detective."
  },
  "notebookEmptyPeople": "No names. Only shadows, so far.",
  "@notebookEmptyPeople": {
    "description": "Shown in the People tab of the notebook while it is empty. Atmospheric, in the voice of the detective."
  },
  "notebookSelectHint": "Pick a note to read it.",
  "@notebookSelectHint": {
    "description": "Shown on the right page of the notebook while no note is selected."
  },
  "dialogueTopicNew": "new",
  "@dialogueTopicNew": {
    "description": "Small tag on a question in the dialogue panel that the player has not asked yet. Very little space: one short word, lower case."
  },
  "dialogueTopicAsked": "asked",
  "@dialogueTopicAsked": {
    "description": "Accessibility text for a question in the dialogue panel that the player has already asked (shown as a check mark)."
  },
  "dialogueContinueHint": "Tap to continue",
